  "aggregation_and_models": {
    "observation_hierarchy": "pixel/landmark -> head -> original photo -> observation -> accepted taxon; linked same head cannot be inferred across photos",
    "within_among": "species-weighted, observer-by-cell balanced, module-specific cohorts, common three-module cohort only for module covariance",
    "colour": "joint L*,a*,b* (re-measured from pixels; legacy C* and circular hue for backward comparison), neutral pixel proportion & observed swatches; four colour fractions are constrained descriptive composition",
    "involucre": "form/taper and phyllary posture/armature treated as related but not equivalent; surface and stickiness kept as distinct assay needs",
    "out_of_sample": "hold out spatial blocks, taxa and photographers separately; compare joint environment predictive importance and shared/unique parts; do not claim causal ranking",
    "phylogeny": "only separate placement sensitivity for primary ecological analysis; EAzami history not silently pooled with global taxon-level states"
  },
