  "purpose": "All 27 image endpoint values persist; biological primary estimands are function-oriented, not 27 independent regressions. EAzami categorical historical character states and aza3 same-individual functional resources are separate evidence layers.",
  "primary_modules": [
    "presentation",
    "visible_floret_colour",
    "involucre_structure"
  ],
  "contextual_modules": [
    "whole_head_geometry",
    "display_context"
  ],
  "dependent_measurement_groups": [
    {
      "group": "presentation",
      "module": "presentation",
      "role": "primary_image_geometry",
      "n_endpoints": 1,
      "needed_new_measurement": "head_base_to_floral_end axis relative to peduncle; gravity angle only from calibrated field/reference"
    },
    {
      "group": "flower_colour",
      "module": "visible_floret_colour",
      "role": "joint_colour_coordinates",
      "n_endpoints": 4,
      "needed_new_measurement": "direct pixel-level L*,a*,b* distribution from independently annotated floral ROI; hue circular and assessable only with adequate chroma"
    },
    {
      "group": "colour_composition",
      "module": "visible_floret_colour",
      "role": "descriptive_composition_secondary",
      "n_endpoints": 4,
      "needed_new_measurement": "joint constrained composition fractions; preserve neutral and mixture classes; never use four independent tests"
    },
    {
      "group": "floral_display",
      "module": "display_context",
      "role": "stage_and_visibility_context",
      "n_endpoints": 1,
      "needed_new_measurement": "floral foreground fraction with separate anthesis-stage annotation; not absolute floral abundance"
    },
    {
      "group": "whole_head_shape",
      "module": "whole_head_geometry",
      "role": "context_and_secondary_trait_block",
      "n_endpoints": 4,
      "needed_new_measurement": "2D head aspect and width profile, explicitly conditional on camera pose; optional allometry context"
    },
    {
      "group": "involucre_body",
      "module": "involucre_structure",
      "role": "candidate_organ_geometry",
      "n_endpoints": 3,
      "needed_new_measurement": "anatomical involucre body mask and base/rim with head-axis normalized profile"
    },
    {
      "group": "phyllary_contour_proxies",
      "module": "involucre_structure",
      "role": "candidate_contour_proxies_not_true_phyllary_anatomy",
      "n_endpoints": 6,
      "needed_new_measurement": "annotated phyllary basal insertion, free tip, relative length, angle and access gap; distinct spine tip measurement"
    },
    {
      "group": "involucre_surface_texture",
      "module": "involucre_structure",
      "role": "technical_validation_only",
      "n_endpoints": 3,
      "needed_new_measurement": "high-resolution macro gland/trichome annotation with sharpness and illuminant controls"
    },
    {
      "group": "involucre_specularity",
      "module": "involucre_structure",
      "role": "technical_validation_only_not_stickiness",
      "n_endpoints": 1,
      "needed_new_measurement": "field/macro sticky secretion presence and strength measured separately; highlight pixels are not adhesive evidence"
    }
  ],
  "rules": {
    "no_27_endpoint_complete_case": true,
    "endpoint_specific_eligibility": true,
    "no_27_independent_pvalues": true,
    "no_across_cameras_colour_pigment_claim": true,
    "no_hue_two_independent_traits": true,
    "no_colour_pixel_fractions_four_independent_predictors": true,
    "no_projection_as_botanical_spine_or_phyllary_posture": true,
    "no_gloss_as_adhesive_mucilage": true,
    "no_image_vertical_as_gravity": true,
    "no_all_head_outline_as_involucre": true,
    "no_pca_axis_called_function_without_field_calibration": true,
    "no_phenotype_correlation_as_genetic_module": true,
    "no_crossrepo_categorical_state_interpolation_to_degrees": true,
    "no_automatic_adjustment_for_head_size_if_mediator_possible": true,
    "observer_and_taxon_weighted_sensitivity": true,
    "phylogenetic_placement_only_as_sensitivity": true
  },
